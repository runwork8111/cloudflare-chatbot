{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Base config = "dev". This is what `wrangler dev` / `wrangler deploy` use
  // when no --env flag is passed.
  "name": "chatbot-worker-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "dev"
  },
  // One D1 database per environment, same binding name ("DB") everywhere so
  // application code never branches on environment. Replace each
  // database_id with the id returned by `wrangler d1 create <name>` — see
  // README for the exact commands.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatbot-worker-db-dev",
      "database_id": "REPLACE_WITH_DEV_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Shared across all environments (not overridden per-env below), one DO
  // instance per rate-limit key.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  // RAG pipeline: uploaded docs (R2), async chunk+embed jobs (Queues), and
  // the vector index chunks are retrieved from (Vectorize). Local `wrangler
  // dev` simulates all three without needing real resources to exist first;
  // real deploys need them created — see README "RAG pipeline" section.
  "r2_buckets": [{ "binding": "DOCS_BUCKET", "bucket_name": "chatbot-worker-docs-dev" }],
  "queues": {
    "producers": [{ "binding": "INGESTION_QUEUE", "queue": "chatbot-worker-ingestion-dev" }],
    "consumers": [
      { "queue": "chatbot-worker-ingestion-dev", "max_batch_size": 5, "max_batch_timeout": 5 }
    ]
  },
  "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "chatbot-worker-chunks-dev" }],
  "env": {
    "staging": {
      "name": "chatbot-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chatbot-worker-db-staging",
          "database_id": "REPLACE_WITH_STAGING_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "DOCS_BUCKET", "bucket_name": "chatbot-worker-docs-staging" }],
      "queues": {
        "producers": [
          { "binding": "INGESTION_QUEUE", "queue": "chatbot-worker-ingestion-staging" }
        ],
        "consumers": [
          {
            "queue": "chatbot-worker-ingestion-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 5
          }
        ]
      },
      "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "chatbot-worker-chunks-staging" }]
    },
    "production": {
      // No suffix: keeps the *.workers.dev prod URL clean, and this is the
      // name that will get a custom domain attached later.
      "name": "chatbot-worker",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chatbot-worker-db-production",
          "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "DOCS_BUCKET", "bucket_name": "chatbot-worker-docs-production" }],
      "queues": {
        "producers": [
          { "binding": "INGESTION_QUEUE", "queue": "chatbot-worker-ingestion-production" }
        ],
        "consumers": [
          {
            "queue": "chatbot-worker-ingestion-production",
            "max_batch_size": 5,
            "max_batch_timeout": 5
          }
        ]
      },
      "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "chatbot-worker-chunks-production" }]
    }
  }
}
